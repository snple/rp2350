/* RP2350 Linker Script for rp2350-rt
 *
 * This linker script is designed for the RP2350 microcontroller.
 * It handles:
 * - Vector table placement
 * - Code and data sections
 * - RAM initialization (.data, .bss)
 * - Stack configuration
 *
 * Usage: Include `memory.x` before this file to define FLASH and RAM regions.
 */

/* Include the memory layout (provided by application or BSP) */
INCLUDE memory.x

/* `DefaultHandler_` is the runtime fallback implementation.
 * `DefaultHandler` is the public weak alias used by this script and device.x.
 * A user-defined `DefaultHandler` function overrides this alias.
 */
PROVIDE(DefaultHandler = DefaultHandler_);

/* Include device-specific interrupt handlers (provided by PAC).
 *
 * NOTE: `device.x` is not shipped by this crate. It is generated by the
 * `rp2350-pac` build script and exposed via `cargo:rustc-link-search`, so a
 * binary using this linker script must also depend on `rp2350-pac`.
 */
INCLUDE device.x

/* Entry point */
ENTRY(Reset);

/* External symbols that must be provided */
EXTERN(__RESET_VECTOR);
EXTERN(Reset);
EXTERN(__EXCEPTIONS);
EXTERN(DefaultHandler);

/* Default exception handlers (can be overridden) */
PROVIDE(NonMaskableInt = DefaultHandler);
PROVIDE(HardFault = HardFault_);
PROVIDE(MemoryManagement = DefaultHandler);
PROVIDE(BusFault = DefaultHandler);
PROVIDE(UsageFault = DefaultHandler);
PROVIDE(SecureFault = DefaultHandler);
PROVIDE(SVCall = DefaultHandler);
PROVIDE(DebugMonitor = DefaultHandler);
PROVIDE(PendSV = DefaultHandler);
PROVIDE(SysTick = DefaultHandler);

/* Device interrupts (provided by device crate) */
EXTERN(__INTERRUPTS);

/* Pre-init function (optional, for assembly-level early init) */
PROVIDE(__pre_init = DefaultPreInit);

SECTIONS
{
    PROVIDE(_ram_start = ORIGIN(RAM));
    PROVIDE(_ram_end = ORIGIN(RAM) + LENGTH(RAM));
    PROVIDE(_stack_start = _ram_end);

    /* ================================================================
     * FLASH Sections
     * ================================================================ */

    /* Vector Table - must be at the start of flash */
    .vector_table ORIGIN(FLASH) :
    {
        __vector_table = .;

        /* Initial Stack Pointer (8-byte aligned) */
        LONG(_stack_start & 0xFFFFFFF8);

        /* Reset Vector */
        KEEP(*(.vector_table.reset_vector));

        /* Exception Vectors (handlers 2-15) */
        __exceptions = .;
        KEEP(*(.vector_table.exceptions));
        __eexceptions = .;

        /* Device-specific Interrupt Vectors */
        KEEP(*(.vector_table.interrupts));
    } > FLASH

    /* Code Section.
     *
     * `.start_block` / binary-info sections are inserted between the vector
     * table and `.text` via `INSERT AFTER`, and their size is not guaranteed
     * to be a multiple of 8. Letting the linker place `.text` (with
     * `ALIGN(8)`) after those inserted sections keeps code addresses 8-byte
     * aligned, satisfying the Cortex-M33 alignment requirement and silencing
     * the linker warning.
     */
    .text : ALIGN(8)
    {
        __stext = .;
        *(.text .text.*);

        /* HardFault trampoline must be near HardFault handler */
        *(.HardFaultTrampoline);
        *(.HardFault.*);

        . = ALIGN(4);
        __etext = .;
    } > FLASH

    /* Read-only Data */
    .rodata : ALIGN(4)
    {
        __srodata = .;
        *(.rodata .rodata.*);
        . = ALIGN(4);
        __erodata = .;
    } > FLASH

    /* ================================================================
     * Boot2 XIP setup blob — optional, executed from RAM
     * ================================================================
     *
     * Holds the <=256-byte second stage boot loader that
     * `rp2350_boot2::init()` copies onto the stack and calls. The blob is
     * position-independent and never executed in place, so it can live
     * anywhere in flash; placing it after `.text` follows the Pico SDK and
     * keeps it out of the first 4 KiB, which the boot ROM scans for the
     * IMAGE_DEF block.
     *
     * Usage:
     *   rp2350 = { features = ["boot2"] }
     */
    .boot2 : ALIGN(4)
    {
        __boot2_start__ = .;
        KEEP(*(.boot2));
        . = ALIGN(4);
        __boot2_end__ = .;
    } > FLASH

    /* ================================================================
     * RAM Functions (.ramfunc) — code loaded into RAM at startup
     * ================================================================
     *
     * Functions marked with #[ramfunc] are placed here.  The linker
     * allocates space for them in RAM (VMA) but stores the initial
     * content in FLASH (LMA).  The startup code copies them to RAM
     * before calling main().
     *
     * Usage:
     *   #[ramfunc]
     *   fn flash_write(...) { ... }
     */
    .ramfunc : ALIGN(4)
    {
        __sramfunc = .;
        *(.ramfunc .ramfunc.*);
        . = ALIGN(4);
        __eramfunc = .;
    } > RAM AT>FLASH
    __siramfunc = LOADADDR(.ramfunc);

    /* ================================================================
     * RAM Sections
     * ================================================================ */

    /* Initialized Data - copied from FLASH to RAM at startup */
    .data : ALIGN(4)
    {
        __sdata = .;
        *(.data .data.*);
        . = ALIGN(4);
    } > RAM AT>FLASH
    __edata = .;
    __sidata = LOADADDR(.data);

    /* TrustZone Veneers (if used) */
    .gnu.sgstubs : ALIGN(32)
    {
        __veneer_base = .;
        *(.gnu.sgstubs*)
        . = ALIGN(32);
        __veneer_limit = .;
    } > FLASH

    /* Uninitialized Data - zeroed at startup */
    .bss (NOLOAD) : ALIGN(4)
    {
        __sbss = .;
        *(.bss .bss.*);
        *(COMMON);
        . = ALIGN(4);
    } > RAM
    __ebss = .;

    /* Explicitly Uninitialized Data - NOT zeroed at startup */
    .uninit (NOLOAD) : ALIGN(4)
    {
        __suninit = .;
        *(.uninit .uninit.*);
        . = ALIGN(4);
        __euninit = .;
    } > RAM

    /* Dynamic relocations check — must precede heap/stack boundary */
    .got (NOLOAD) :
    {
        KEEP(*(.got .got.*));
    }

    /* Heap starts here */
    . = ALIGN(4);
    PROVIDE(__sheap = .);
    PROVIDE(_stack_end = .);

    /* Discard unused exception info */
    /DISCARD/ :
    {
        *(.ARM.exidx);
        *(.ARM.exidx.*);
        *(.ARM.extab.*);
    }
}

/* ================================================================
 * Alignment Assertions
 * ================================================================ */

ASSERT(ORIGIN(FLASH) % 4 == 0, "
ERROR(rp2350-rt): FLASH origin must be 4-byte aligned");

ASSERT(ORIGIN(RAM) % 4 == 0, "
ERROR(rp2350-rt): RAM origin must be 4-byte aligned");

ASSERT(__stext % 4 == 0 && __etext % 4 == 0, "
BUG(rp2350-rt): .text is not 4-byte aligned");

ASSERT(__srodata % 4 == 0 && __erodata % 4 == 0, "
BUG(rp2350-rt): .rodata is not 4-byte aligned");

ASSERT(__boot2_end__ - __boot2_start__ <= 256, "
ERROR(rp2350-rt): .boot2 exceeds 256 bytes and cannot be copied into RAM");

ASSERT(__sramfunc % 4 == 0 && __eramfunc % 4 == 0, "
BUG(rp2350-rt): .ramfunc is not 4-byte aligned");

ASSERT(__siramfunc % 4 == 0, "
BUG(rp2350-rt): LMA of .ramfunc is not 4-byte aligned");

ASSERT(__sdata % 4 == 0 && __edata % 4 == 0, "
BUG(rp2350-rt): .data is not 4-byte aligned");

ASSERT(__sidata % 4 == 0, "
BUG(rp2350-rt): LMA of .data is not 4-byte aligned");

ASSERT(__sbss % 4 == 0 && __ebss % 4 == 0, "
BUG(rp2350-rt): .bss is not 4-byte aligned");

ASSERT(__sheap % 4 == 0, "
BUG(rp2350-rt): heap start is not 4-byte aligned");

ASSERT(_stack_start % 8 == 0, "
ERROR(rp2350-rt): stack start must be 8-byte aligned");

ASSERT(_stack_end % 4 == 0, "
ERROR(rp2350-rt): stack end must be 4-byte aligned");

ASSERT(_stack_start >= _stack_end, "
ERROR(rp2350-rt): stack end must be below stack start");

/* Vector table checks */
ASSERT(__exceptions == ADDR(.vector_table) + 0x8, "
BUG(rp2350-rt): reset vector is missing");

ASSERT(__eexceptions == ADDR(.vector_table) + 0x40, "
BUG(rp2350-rt): exception vectors are missing");

/* Dynamic relocation check */
ASSERT(SIZEOF(.got) == 0, "
ERROR(rp2350-rt): .got section detected - dynamic relocations not supported");
